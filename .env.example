# Copy to .env and replace placeholders locally. Never commit real credentials.

# --- Database (Supabase Postgres preferred) ---
# Apply: supabase/migrations/20261113000000_init_schema.sql then supabase/seed.sql
# Docs: docs/database/SUPABASE.md
POSTGRES_DB=tradesquare
POSTGRES_USER=tradesquare
POSTGRES_PASSWORD=replace-with-a-local-secret
# Local Docker:
DATABASE_URL=postgresql+psycopg://tradesquare:replace-with-a-local-secret@localhost:5432/tradesquare
# Or Supabase pooler URI (backend rewrites to +psycopg):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server only — never put in Flutter
# Flutter Auth: also apply supabase/migrations/20261113010000_auth_profiles.sql
# Role after login comes from profiles.account_intent / profiles.role (no login role picker).

# Optional Discover voice / AI workers (leave blank to keep on-device fallbacks)
DISCOVER_STT_WORKER_URL=
DISCOVER_TTS_WORKER_URL=
DISCOVER_LLM_URL=
DISCOVER_LLM_API_KEY=

# Optional LiveKit Agents realtime voice / messaging calls
# Create a project at https://cloud.livekit.io/ then fill these values.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional call translation workers (leave blank to keep direct A/V + glossary text only)
CALL_LIBRETRANSLATE_URL=
CALL_STT_WORKER_URL=
CALL_TTS_WORKER_URL=

# ALTATTS 2.x local package evaluation (Apache-2.0). PyPI has no model weights.
ALTATTS_MODEL_PATH=
ALTATTS_REF_RW_WAV=
ALTATTS_REF_SW_WAV=
ALTATTS_DEVICE=cpu
ENABLE_ALTATTS_CALLS=0

# ALTA by YaliLabs (https://alta.yalilabs.com) — backend only. Never put the key in Flutter.
ALTA_BASE_URL=https://alta.yalilabs.com/v1
ALTA_API_KEY=
ALTA_ENABLED=false
ALTA_TRANSCRIPTION_ENABLED=false
ALTA_TRANSLATION_ENABLED=false
ALTA_TTS_ENABLED=false
ALTA_VOICE_CLONING_ENABLED=false
ALTA_LIVE_TRANSCRIPTION_ENABLED=false
ALTA_CALL_TRANSLATION_ENABLED=false
ALTA_TRANSCRIPTION_MODEL=v2
ALTA_TRANSCRIPTION_QUALITY=fast
ALTA_LIVE_TRANSCRIPTION_PERSIST=false
ALTA_REQUEST_TIMEOUT=30
# Legacy TTS eval flag (still honored by AltaConsoleTtsAdapter)
ENABLE_ALTA_CONSOLE_TTS=0

# Flutter / clients
TRADESQUARE_API_BASE_URL=http://localhost:8000
